// Reduce is used to reduce the array to a single value by applying a function to each element of the array.
console.log(`"${"*".repeat(10)}"`);
const testCaseId = [1, 2, 3, 4, 5];
const sum = testCaseId.reduce((acc, curr) => acc + curr, 0);
console.log(`Sum of array elements: ${sum}`);

const product = testCaseId.reduce((acc, curr) => acc * curr, 1);
console.log(`Product of array elements: ${product}`);

// Concat is used to merge two or more arrays.
console.log(`"${"*".repeat(10)}"`);
const testCaseNames1 = ["Login", "Logout", "Search"];
const testCaseNames2 = ["Checkout", "Payment"];
const mergedTestCases = testCaseNames1.concat(testCaseNames2);
console.log(`Merged array: ${mergedTestCases}`);

// forEach is used to execute a provided function once for each array element.
console.log(`"${"*".repeat(10)}"`);
const testCases = [
    "Login Test",
    "Logout Test",
    "Search Test",
    "Add to Card Test",
    "Checkout Test"
];

testCases.forEach((testCase, index) => {
    console.log(`Test ${index + 1}: ${testCase}`);
});